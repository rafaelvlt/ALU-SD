`timescale 1 ps/ 1 ps
module miniMux_vlg_vec_tst();
// constants                                           
// general purpose registers
reg AND;
reg C2deB;
reg [2:0] S;
reg Soma;
reg Sub;
reg XOR;
// wires                                               
wire outbit;

// assign statements (if any)                          
miniMux i1 (
// port map - connection between master ports and signals/registers   
	.\AND (AND),
	.C2deB(C2deB),
	.outbit(outbit),
	.S(S),
	.Soma(Soma),
	.Sub(Sub),
	.\XOR (XOR)
);
initial 
begin 
#1000000 $finish;
end 

// Soma
always
begin
	Soma = 1'b0;
	Soma = #10000 1'b1;
	#10000;
end 

// Sub
always
begin
	Sub = 1'b0;
	Sub = #20000 1'b1;
	#20000;
end 

